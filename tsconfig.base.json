{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@collab/protocol": ["./packages/protocol/src/index.ts"],
      "@collab/geometry": ["./packages/geometry/src/index.ts"],
      "@collab/board-core": ["./packages/board-core/src/index.ts"],
      "@collab/svg-export": ["./packages/svg-export/src/index.ts"],
      "@collab/test-fixtures": ["./packages/test-fixtures/src/index.ts"]
    }
  }
}
