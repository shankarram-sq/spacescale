            },
            {
              "kind": "filter",
              "key": "actionKind",
              "operation": "in",
              "type": "string",
              "value": "history.undo,history.redo"
            }
          ],
          "calculations": [{ "operator": "count", "alias": "outcomes" }],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "actionKind" },
            { "type": "string", "value": "result" },
            { "type": "string", "value": "code" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "stacked_time_series",
        "unit": "commands",
        "calculations": ["outcomes"],
        "splitBy": ["environment", "actionKind", "result", "code"],
        "prominent": false
      }
    },
    {
      "id": "board_item_and_storage",
      "metricIds": ["board_item_count"],
      "saveRequest": {
        "name": "[Collab Canvas] Board item and storage utilization",
        "description": "Peak item count, estimated SQLite bytes, and utilization ratios per privacy-safe board hash.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "eq",
              "type": "string",
              "value": "board.metrics"
            }
          ],
          "calculations": [
            { "operator": "max", "alias": "items", "key": "itemCount", "keyType": "number" },
            {
              "operator": "max",
              "alias": "storage_bytes",
              "key": "storageBytesEstimate",
              "keyType": "number"
            },
            {
              "operator": "max",
              "alias": "item_utilization",
              "key": "itemLimitUtilization",
              "keyType": "number"
            },
            {
              "operator": "max",
              "alias": "storage_utilization",
              "key": "storageLimitUtilization",
              "keyType": "number"
            }
          ],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "boardIdHash" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "table",
        "unit": "mixed",
        "calculations": ["items", "storage_bytes", "item_utilization", "storage_utilization"],
        "splitBy": ["environment", "boardIdHash"],
        "prominent": true
      }
    },
    {
      "id": "quota_estimates",
      "metricIds": ["quota_estimates"],
      "saveRequest": {
        "name": "[Collab Canvas] UTC-day quota estimates",
        "description": "Persisted per-board daily estimates for frames, Durable Object request units, SQLite, R2, actions, and snapshots; account usage comes from Cloudflare platform analytics.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "eq",
              "type": "string",
              "value": "quota.daily"
            }
          ],
          "calculations": [
            {
              "operator": "max",
              "alias": "incoming_frames",
              "key": "incomingFrames",
              "keyType": "number"
            },
            {
              "operator": "max",
              "alias": "do_request_units",
              "key": "durableObjectRequestUnitsEstimate",
              "keyType": "number"
            },
            {
              "operator": "max",
              "alias": "rows_read",
              "key": "sqliteRowsRead",
              "keyType": "number"
            },
            {
              "operator": "max",
              "alias": "rows_written",
              "key": "sqliteRowsWritten",
              "keyType": "number"
            },
            { "operator": "max", "alias": "r2_reads", "key": "r2Reads", "keyType": "number" },
            { "operator": "max", "alias": "r2_writes", "key": "r2Writes", "keyType": "number" },
            {
              "operator": "max",
              "alias": "r2_bytes_written",
              "key": "r2BytesWritten",
              "keyType": "number"
            },
            { "operator": "max", "alias": "actions", "key": "actions", "keyType": "number" },
            { "operator": "max", "alias": "snapshots", "key": "snapshots", "keyType": "number" }
          ],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "boardIdHash" },
            { "type": "string", "value": "quotaDayUtc" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "table",
        "unit": "mixed",
        "calculations": [
          "incoming_frames",
          "do_request_units",
          "rows_read",
          "rows_written",
          "r2_reads",
          "r2_writes",
          "r2_bytes_written",
          "actions",
          "snapshots"
        ],
        "splitBy": ["environment", "boardIdHash", "quotaDayUtc"],
        "prominent": true
      }
    },
    {
      "id": "handler_internal_error_rate",
      "metricIds": ["handler_internal_error_rate"],
      "saveRequest": {
        "name": "[Collab Canvas] Handler internal-error outcomes",
        "description": "Exactly one normalized completion per gateway or Durable Object HTTP handler, split by internal-error classification.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "in",
              "type": "string",
              "value": "http.request_completed,room.http_completed"
            }
          ],
          "calculations": [{ "operator": "count", "alias": "handlers" }],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "executionComponent" },
            { "type": "boolean", "value": "internalError" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "stacked_time_series",
        "unit": "handlers",
        "calculations": ["handlers"],
        "splitBy": ["environment", "executionComponent", "internalError"],
        "prominent": true
      }
    },
    {
      "id": "worker_do_cpu_time",
      "metricIds": ["worker_do_cpu_time"],
      "saveRequest": {
        "name": "[Collab Canvas] Worker and Durable Object CPU",
        "description": "Built-in invocation CPU and wall-time quantiles split between stateless Worker and Durable Object entrypoints.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "$metadata.type",
              "operation": "eq",
              "type": "string",
              "value": "cf-worker-event"
            }
          ],
          "calculations": [
            { "operator": "count", "alias": "invocations" },
            {
              "operator": "median",
              "alias": "cpu_p50_ms",
              "key": "$workers.cpuTimeMs",
              "keyType": "number"
            },
            {
              "operator": "p95",
              "alias": "cpu_p95_ms",
              "key": "$workers.cpuTimeMs",
              "keyType": "number"
            },
            {
              "operator": "p99",
              "alias": "cpu_p99_ms",
              "key": "$workers.cpuTimeMs",
              "keyType": "number"
            },
            {
              "operator": "p95",
              "alias": "wall_p95_ms",
              "key": "$workers.wallTimeMs",
              "keyType": "number"
            }
          ],
          "groupBys": [
            { "type": "string", "value": "$metadata.service" },
            { "type": "string", "value": "$workers.executionModel" },
            { "type": "string", "value": "$workers.entrypoint" },
            { "type": "string", "value": "$workers.outcome" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "time_series",
        "unit": "milliseconds",
        "calculations": ["cpu_p50_ms", "cpu_p95_ms", "cpu_p99_ms", "wall_p95_ms"],
        "splitBy": [
          "$metadata.service",
          "$workers.executionModel",
          "$workers.entrypoint",
          "$workers.outcome"
        ],
        "prominent": true
      }
    }
  ],
  "alerts": [
    {
      "id": "rejected_commands_5pct_5m",
      "queryId": "commands_by_result_code",
      "severity": "page",
      "window": "5m",
      "holdFor": "5m",
      "groupBy": ["environment"],
      "condition": {
        "kind": "ratio",
        "numerator": "events where event=command.rejected",
        "denominator": "all events",
        "operator": "gt",
        "threshold": 0.05
      },
      "runbook": "Inspect rejection codes before changing limits; INVALID_* spikes and RATE_LIMITED spikes have different owners."
    },
    {
      "id": "internal_errors_1pct",
      "queryId": "handler_internal_error_rate",
      "severity": "page",
      "window": "5m",
      "holdFor": "0m",
      "groupBy": ["environment", "executionComponent"],
      "condition": {
        "kind": "ratio",
        "numerator": "handlers where internalError=true",
        "denominator": "all handlers",
        "operator": "gt",
        "threshold": 0.01
      },
      "runbook": "Check built-in invocation outcomes and error logs, then isolate gateway versus BoardRoom."
    },
    {
      "id": "snapshot_lag_1000_actions_or_30m",
      "queryId": "snapshot_lag",
      "severity": "page",
      "window": "5m",
      "holdFor": "0m",
      "groupBy": ["environment", "boardIdHash"],
      "condition": {
        "kind": "any",
        "operator": "gt",
        "signals": [
          { "calculation": "max_lag_actions", "threshold": 1000, "unit": "actions" },
          { "calculation": "max_lag_ms", "threshold": 1800000, "unit": "milliseconds" }
        ]
      },
      "runbook": "Inspect snapshot.failed and scheduled-alarm state; SQLite remains authoritative."
    },
    {
      "id": "board_item_or_storage_80pct",
      "queryId": "board_item_and_storage",
      "severity": "warn",
      "window": "5m",
      "holdFor": "0m",
      "groupBy": ["environment", "boardIdHash"],
      "condition": {
        "kind": "any",
        "operator": "gt",
        "signals": [
          { "calculation": "item_utilization", "threshold": 0.8, "unit": "ratio" },
          { "calculation": "storage_utilization", "threshold": 0.8, "unit": "ratio" }
        ]
      },
      "runbook": "Identify the privacy-safe board hash, freeze new mutations if necessary, and follow the SQLite-full runbook."
    },
    {
      "id": "daily_request_or_row_write_70pct",
      "queryId": "quota_estimates",
      "severity": "page",
      "window": "15m",
      "holdFor": "0m",
      "groupBy": ["environment"],
      "condition": {
        "kind": "any",
        "operator": "gt",
        "signals": [
          {
            "source": "cloudflare_platform_analytics",
            "calculation": "account_request_utilization",
            "definition": "Maximum of UTC-day account Worker-request utilization and Durable Object billed-request utilization against their applicable plan allowances.",
            "threshold": 0.7,
            "unit": "ratio"
          },
          {
            "source": "cloudflare_platform_analytics",
            "calculation": "account_row_write_utilization",
            "definition": "UTC-day account Durable Object SQLite rows written divided by the applicable plan allowance.",
            "threshold": 0.7,
            "unit": "ratio"
          }
        ]
      },
      "runbook": "Use account-wide Cloudflare request and SQLite usage for the threshold; use per-board quota.daily estimates only for drilldown. Disable new board creation before a hard free-plan limit while preserving existing read/reconnect/export paths."
    },
    {
      "id": "replay_resync_2pct",
      "queryId": "replay_size_and_resync",
      "severity": "warn",
      "window": "15m",
      "holdFor": "0m",
      "groupBy": ["environment"],
      "condition": {
        "kind": "ratio",
        "numerator": "connections where resyncRequired=true",
        "denominator": "all connections",
        "operator": "gt",
        "threshold": 0.02
      },
      "runbook": "Check replay retention/compaction boundaries and client prior-sequence distribution."
    },
    {
      "id": "commit_p95_25ms",
      "queryId": "commit_latency",
      "severity": "warn",
      "window": "5m",
      "holdFor": "0m",
      "groupBy": ["environment", "actionKind"],
      "condition": {
        "kind": "scalar",
        "calculation": "p95_ms",
        "operator": "gt",
        "threshold": 25,
        "unit": "milliseconds"
      },
      "runbook": "Compare action kinds, SQLite transaction duration, and built-in BoardRoom CPU before optimizing."
    }
  ],
  "delivery": {
    "provisioned": false,
    "savedQueriesScheduleAlerts": false,
    "evaluatorRequired": true,
    "minimumEvaluationInterval": "1m",
    "destinationKinds": ["email", "pagerduty", "webhook"],
    "prerequisites": [
      "Workers Logs is enabled for every deployed environment and field keys are verified with the telemetry keys endpoint.",
      "A scheduler or external observability service runs the saved queries and evaluates the declarative conditions.",
      "The quota evaluator reads account-wide Worker, Durable Object, duration, and SQLite usage from Cloudflare Metrics and Analytics rather than summing sampled custom logs.",
      "At least one tested notification destination and an owned escalation path are configured.",
      "The evaluator deduplicates incidents, records last success, and emits a stale-evaluator alert when queries stop running.",
      "Cloudflare Notification destinations are checked for account-plan eligibility before selecting PagerDuty or webhooks."
    ],
    "optionalCloudflareNotificationPermission": "Notifications Write"
  }
}
