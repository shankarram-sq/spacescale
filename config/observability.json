    "alertsSection": "20.3"
  },
  "api": {
    "baseUrl": "https://api.cloudflare.com/client/v4",
    "saveQuery": {
      "method": "POST",
      "path": "/accounts/{account_id}/workers/observability/queries",
      "permission": "Workers Observability Write"
    },
    "dataset": "cloudflare-workers"
  },
  "dashboard": {
    "title": "Collab Canvas service health",
    "audience": "on-call and service operators",
    "defaultWindow": "1h",
    "refreshInterval": "1m",
    "filters": ["$metadata.service", "environment", "boardIdHash", "actionKind", "code"]
  },
  "coverage": {
    "specMetricIds": [
      "active_sockets_per_board",
      "preview_and_commit_frames",
      "accepted_rejected_commands_by_code",
      "commit_latency",
      "broadcast_fanout_and_send_failures",
      "replay_size_and_resync_rate",
      "sqlite_transaction_duration",
      "snapshot_lag_actions_and_time",
      "r2_snapshot_duration_and_failure",
      "undo_redo_success_and_conflict_rate",
      "board_item_count",
      "quota_estimates"
    ],
    "platformMetricIds": ["worker_do_cpu_time", "handler_internal_error_rate"],
    "alertIds": [
      "rejected_commands_5pct_5m",
      "internal_errors_1pct",
      "snapshot_lag_1000_actions_or_30m",
      "board_item_or_storage_80pct",
      "daily_request_or_row_write_70pct",
      "replay_resync_2pct",
      "commit_p95_25ms"
    ]
  },
  "runtimeContract": {
    "structuredPayload": "object",
    "commonFields": {
      "event": "string",
      "level": "string",
      "at": "number",
      "environment": "string",
      "requestId": "string",
      "boardIdHash": "string",
      "workerVersionId": "string",
      "durableObjectVersion": "string",
      "protocolVersion": "number",
      "actionCount": "number",
      "frameBytes": "number",
      "attempt": "number"
    },
    "builtInFields": {
      "$metadata.service": "string",
      "$metadata.type": "string",
      "$workers.cpuTimeMs": "number",
      "$workers.wallTimeMs": "number",
      "$workers.outcome": "string",
      "$workers.executionModel": "string",
      "$workers.entrypoint": "string",
      "$workers.durableObjectId": "string"
    },
    "events": [
      {
        "event": "board.metrics",
        "cadence": "On gauge change, rate-limited to once per active board per minute; always emit zero active sockets after the final disconnect.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "activeSockets": "number",
          "snapshotLagActions": "number",
          "snapshotLagMs": "number",
          "itemCount": "number",
          "storageBytesEstimate": "number",
          "itemLimitUtilization": "number",
          "storageLimitUtilization": "number"
        }
      },
      {
        "event": "traffic.metrics",
        "cadence": "Aggregate per board; never emit one event per preview or presence frame.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "previewFrames": "number",
          "commitFrames": "number",
          "sampleWindowMs": "number"
        }
      },
      {
        "event": "command.accepted",
        "cadence": "Once per accepted durable command.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "protocolVersion": "number",
          "actionKind": "string",
          "result": "string",
          "code": "string",
          "seq": "number",
          "durationMs": "number"
        }
      },
      {
        "event": "command.rejected",
        "cadence": "Once per rejected durable command.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "protocolVersion": "number",
          "actionKind": "string",
          "result": "string",
          "code": "string",
          "durationMs": "number"
        }
      },
      {
        "event": "broadcast.completed",
        "cadence": "Once per durable action broadcast, including zero failures.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "fanout": "number",
          "sendFailures": "number"
        }
      },
      {
        "event": "replay.completed",
        "cadence": "Exactly one replay outcome per accepted WebSocket connection, including zero-action replays.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string",
          "code": "string",
          "replayActions": "number",
          "replayBytes": "number",
          "resyncRequired": "boolean"
        }
      },
      {
        "event": "replay.unavailable",
        "cadence": "Exactly one replay outcome for a connection forced to authoritative resync.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string",
          "code": "string",
          "replayActions": "number",
          "replayBytes": "number",
          "resyncRequired": "boolean"
        }
      },
      {
        "event": "storage.transaction_completed",
        "cadence": "Once per durable command transaction, including typed rollbacks.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string",
          "code": "string",
          "durationMs": "number",
          "sqliteRowsRead": "number",
          "sqliteRowsWritten": "number"
        }
      },
      {
        "event": "snapshot.completed",
        "cadence": "Once per completed named or automatic R2 snapshot.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string",
          "code": "string",
          "seq": "number",
          "durationMs": "number",
          "r2BytesWritten": "number"
        }
      },
      {
        "event": "snapshot.failed",
        "cadence": "Once per failed R2 snapshot attempt.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string",
          "code": "string",
          "seq": "number",
          "durationMs": "number",
          "r2BytesWritten": "number"
        }
      },
      {
        "event": "quota.daily",
        "cadence": "Persisted UTC-day cumulative sample for one board; never reset on eviction and never claim to aggregate an account.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "quotaDayUtc": "string",
          "incomingFrames": "number",
          "durableObjectRequestUnitsEstimate": "number",
          "sqliteRowsRead": "number",
          "sqliteRowsWritten": "number",
          "r2Reads": "number",
          "r2Writes": "number",
          "r2BytesWritten": "number",
          "actions": "number",
          "snapshots": "number"
        }
      },
      {
        "event": "http.request_completed",
        "cadence": "Exactly once per gateway invocation, after error mapping.",
        "requiredFields": {
          "environment": "string",
          "executionComponent": "string",
          "status": "number",
          "internalError": "boolean",
          "durationMs": "number"
        }
      },
      {
        "event": "room.http_completed",
        "cadence": "Exactly once per Durable Object HTTP invocation, after error mapping.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "executionComponent": "string",
          "status": "number",
          "internalError": "boolean",
          "durationMs": "number"
        }
      },
      {
        "event": "board.created",
        "cadence": "Once per initialized board.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string"
        }
      },
      {
        "event": "socket.connected",
        "cadence": "Once per accepted WebSocket connection.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "protocolVersion": "number",
          "result": "string"
        }
      },
      {
        "event": "socket.disconnected",
        "cadence": "Once per closed WebSocket connection.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "closeCode": "number",
          "result": "string"
        }
      },
      {
        "event": "membership.changed",
        "cadence": "Once per membership or invitation state change.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "result": "string"
        }
      },
      {
        "event": "rate_limit.triggered",
        "cadence": "Sample repeated occurrences; do not emit one event per dropped preview/presence frame.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "code": "string",
          "result": "string"
        }
      },
      {
        "event": "room.overloaded",
        "cadence": "Once when an overload state begins and once when it materially changes.",
        "requiredFields": {
          "environment": "string",
          "boardIdHash": "string",
          "code": "string",
          "result": "string"
        }
      },
      {
        "event": "schema.migrated",
        "cadence": "Once per successfully applied schema migration.",
        "requiredFields": {
          "environment": "string",
          "durableObjectVersion": "string",
          "result": "string",
          "seq": "number"
        }
      }
    ],
    "privacy": {
      "boardIdentity": "Use a stable one-way SHA-256 digest in boardIdHash; never log the routable board ID.",
      "forbiddenFields": [
        "operation",
        "operationJson",
        "text",
        "dataJson",
        "cookie",
        "authorization",
        "inviteToken",
        "recoveryToken",
        "sessionSignature",
        "rawBoardId",
        "actorId",
        "displayName",
        "ip",
        "userAgent"
      ]
    }
  },
  "savedQueries": [
    {
      "id": "active_sockets_per_board",
      "metricIds": ["active_sockets_per_board"],
      "saveRequest": {
        "name": "[Collab Canvas] Active sockets per board",
        "description": "Latest and peak active WebSocket gauges, split by environment and privacy-safe board hash.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "eq",
              "type": "string",
              "value": "board.metrics"
            }
          ],
          "calculations": [
            {
              "operator": "max",
              "alias": "max_active_sockets",
              "key": "activeSockets",
              "keyType": "number"
            }
          ],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "boardIdHash" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "time_series",
        "unit": "connections",
        "calculations": ["max_active_sockets"],
        "splitBy": ["environment", "boardIdHash"],
        "prominent": true
      }
    },
    {
      "id": "preview_and_commit_frames",
      "metricIds": ["preview_and_commit_frames"],
      "saveRequest": {
        "name": "[Collab Canvas] Preview and commit frames",
        "description": "Aggregated frame volume; preview and presence traffic is never logged per frame.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
