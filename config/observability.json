            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "eq",
              "type": "string",
              "value": "traffic.metrics"
            }
          ],
          "calculations": [
            {
              "operator": "sum",
              "alias": "preview_frames",
              "key": "previewFrames",
              "keyType": "number"
            },
            {
              "operator": "sum",
              "alias": "commit_frames",
              "key": "commitFrames",
              "keyType": "number"
            }
          ],
          "groupBys": [{ "type": "string", "value": "environment" }],
          "limit": 100
        }
      },
      "chart": {
        "type": "time_series",
        "unit": "frames",
        "calculations": ["preview_frames", "commit_frames"],
        "splitBy": ["environment"],
        "prominent": false
      }
    },
    {
      "id": "commands_by_result_code",
      "metricIds": ["accepted_rejected_commands_by_code"],
      "saveRequest": {
        "name": "[Collab Canvas] Commands by result and code",
        "description": "Accepted and rejected durable commands grouped by stable result code and action kind.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
