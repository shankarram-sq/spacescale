    },
    {
      "id": "commit_latency",
      "metricIds": ["commit_latency"],
      "saveRequest": {
        "name": "[Collab Canvas] Commit handling latency",
        "description": "Median, p95, and p99 accepted command handling time measured around the full durable handler.",
        "parameters": {
          "datasets": ["cloudflare-workers"],
          "filterCombination": "and",
          "filters": [
            {
              "kind": "filter",
              "key": "$metadata.service",
              "operation": "starts_with",
              "type": "string",
              "value": "cloudflare-collab-canvas"
            },
            {
              "kind": "filter",
              "key": "event",
              "operation": "eq",
              "type": "string",
              "value": "command.accepted"
            }
          ],
          "calculations": [
            { "operator": "median", "alias": "p50_ms", "key": "durationMs", "keyType": "number" },
            { "operator": "p95", "alias": "p95_ms", "key": "durationMs", "keyType": "number" },
            { "operator": "p99", "alias": "p99_ms", "key": "durationMs", "keyType": "number" }
          ],
          "groupBys": [
            { "type": "string", "value": "environment" },
            { "type": "string", "value": "actionKind" }
          ],
          "limit": 100
        }
      },
      "chart": {
        "type": "time_series",
        "unit": "milliseconds",
        "calculations": ["p50_ms", "p95_ms", "p99_ms"],
        "splitBy": ["environment", "actionKind"],
        "prominent": true
      }
    },
    {
