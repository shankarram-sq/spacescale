# -----------------------------------------------------------------------------
# Application configuration
# -----------------------------------------------------------------------------

# Private R2 bucket used for board checkpoints and exports.
# Choose a stable, environment-specific name. `npm run cf:bootstrap` creates it
# when missing, so no dashboard bucket creation or R2 S3 credentials are needed.
R2_BUCKET_NAME=collab-canvas-snapshots

# Public Turnstile site key.
# Get it from: Cloudflare Dashboard > Turnstile > select the application widget
# > copy "Site Key". This value is safe to expose to the browser.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# SECRET: signs board sessions and capability grants.
# Generate a new value for every environment with: openssl rand -base64 32
# Put the real value in the local/CI secret store, never in a committed file.
SESSION_SIGNING_KEY_CURRENT=replace-with-random-signing-key

# Optional previous signing key used only during a controlled rotation window.
# Leave unset for a fresh installation. Never reuse a key between environments.
SESSION_SIGNING_KEY_PREVIOUS=

# SECRET: shared only by this Worker and the classroom backend. The backend
# uses it to HMAC-sign short-lived per-participant launch URLs. Keep this value
# stable so deterministic board and actor identifiers remain stable.
# Generate with: openssl rand -base64 32
CLASSROOM_INTEGRATION_KEY=replace-with-random-classroom-integration-key

# Public hostname only: no scheme, path, query, or trailing slash.
# Production is served from this custom hostname. Staging uses
# staging-cloud-collab.spacescale.net and has Turnstile disabled. The production
# value must also be present in the production Turnstile widget hostname list.
APP_HOSTNAME=spacescale.net

# Comma-separated exact HTTPS origins that may embed `/embed` (no paths).
# Blank or absent denies all iframe parents. A literal `*` allows every parent;
# use that explicit opt-in only when unrestricted embedding is intentional.
ALLOWED_ORIGINS=

# Public operational switch. Set false to stop new board creation while keeping
# existing board read/reconnect/export routes available.
BOARD_CREATION_ENABLED=true

# -----------------------------------------------------------------------------
# Cloudflare provisioning and deployment credentials
# -----------------------------------------------------------------------------

# Cloudflare account ID. It is not cryptographically secret, but keeping it in
# the CI secret group is acceptable. Find it in Cloudflare Dashboard > select
# the account > Account home/Overview > copy "Account ID".
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id

# SECRET: standard Cloudflare management API token used by bootstrap and CI.
# This is NOT an R2 S3 Access Key ID or Secret Access Key.
#
# Exact creation steps:
# 1. Cloudflare Dashboard > Manage Account > Account API Tokens.
# 2. Select "Create Token", then "Create Custom Token".
# 3. Add Account > Workers Scripts > Edit (`Workers Scripts Write`).
# 4. Add Account > Workers R2 Storage > Edit
#    (`Workers R2 Storage Write`) so bootstrap can create the R2 bucket.
# 5. Under Account Resources choose Include > the one target account.
# 6. Add no Zone permissions or Zone resources when using workers.dev or a
#    Worker Custom Domain.
# 7. Add a TTL and client-IP restriction when the CI egress IP is stable.
# 8. Review, create, copy the token once, and save it only in the secret store.
#
# After bootstrap, a least-privilege deploy-only token may retain only Workers
# Scripts: Edit. Keeping R2 Storage: Edit allows future bucket provisioning but
# increases the impact of a leaked token.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# SECRET: Turnstile server-side Siteverify credential.
# Get it from: Cloudflare Dashboard > Turnstile > select the application widget
# > Settings/details > copy "Secret Key". This is not the public Site Key.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
